{
  "id": "./",
  "name": "Keepframe",
  "short_name": "Keepframe",
  "description": "Patch MP4/MOV headers on your phone for higher-quality TikTok uploads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0D0F13",
  "theme_color": "#0D0F13",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": [
            "video/*",
            ".mp4",
            ".mov",
            ".m4v"
          ]
        }
      ]
    }
  }
}
